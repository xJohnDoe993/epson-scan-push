[Unit]
Description=Epson ET-4800 "Scan to Computer" receiver (Fedora laptop)
After=network-online.target
Wants=network-online.target

[Service]
# Patched epsonds (JPEG) takes precedence over the system backend
Environment=LD_LIBRARY_PATH=%h/.local/lib/sane-jpeg
Environment=CLIENT_NAME=Notebook
Environment=SCAN_CMD=%h/.local/bin/scan2folder
ExecStart=/usr/bin/python3 -u %h/.local/bin/scan-push.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
