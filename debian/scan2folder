#!/bin/bash
# Scans with the Epson ET-4800 (epsonds backend), A4, 300 dpi, color,
# and drops a PDF into the output folder (default: the Paperless consume folder).
# Usage: scan2folder [adf|flatbed] [name]   (default: adf; name: Scan_<date>)
# Environment: SCAN_DIR (output folder), SCAN_DEVICE, SCAN_RES, SCAN_MODE, SCAN_TRIES
set -u
CONSUME="${SCAN_DIR:-/opt/paperless_data/consume}"
mkdir -p "$CONSUME"
RES="${SCAN_RES:-300}"
MODE="${SCAN_MODE:-Color}"
case "${1:-adf}" in
  flatbed) SRC=Flatbed ;;
  *)       SRC="ADF Front" ;;
esac
DEV="${SCAN_DEVICE:-$(scanimage -f '%d%n' -L 2>/dev/null | grep '^epsonds:' | head -1)}"
[ -n "$DEV" ] || { echo "Epson scanner not found (set SCAN_DEVICE)" >&2; exit 1; }
NAME="${2:-Scan_$(date +%F_%H-%M-%S)}"
TMP=$(mktemp -d /tmp/scan.XXXXXX); trap 'rm -rf "$TMP"' EXIT
exec 9>/run/lock/scanner.lock; flock 9
# After waking up the printer often wrongly reports the feeder as empty: up to 3 tries
# Flatbed: exactly 1 page. Without --batch-count scanimage rescans the glass endlessly
# (there is no "feeder empty" to end it) and the carriage keeps moving back and forth.
CNT=()
[ "$SRC" = "Flatbed" ] && CNT=(--batch-count=1)
for try in $(seq 1 "${SCAN_TRIES:-3}"); do
  scanimage -d "$DEV" --source "$SRC" --mode "$MODE" --resolution "$RES" \
    -x 210 -y 297 --format=jpeg --batch="$TMP/p%04d.jpg" "${CNT[@]}" 2>"$TMP/err.log"
  rc=$?
  ls "$TMP"/p*.jpg >/dev/null 2>&1 && break
  [ "$SRC" = "Flatbed" ] && break
  grep -q "out of documents" "$TMP/err.log" || break
  sleep 8
done
# "Document feeder out of documents" after the last page is normal
ls "$TMP"/p*.jpg >/dev/null 2>&1 || { echo "No pages scanned (rc=$rc): $(tail -2 "$TMP/err.log")" >&2; exit 2; }
img2pdf --pagesize A4 "$TMP"/p*.jpg -o "$TMP/out.pdf"
mv "$TMP/out.pdf" "$CONSUME/$NAME.pdf"
echo "OK: $CONSUME/$NAME.pdf ($(ls "$TMP"/p*.jpg | wc -l) pages)"
